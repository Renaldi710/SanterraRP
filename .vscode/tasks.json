{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-main",
            "type": "shell",
            "command": "${workspaceFolder}/qawno/pawncc.exe",
            "args": [
                "${workspaceFolder}/gamemodes/main.pwn",
                "-Dgamemodes",
                "-;+",
                "-(+",
                "-d3",
                "-o${workspaceFolder}/gamemodes/main.amx"
            ],
            "options": {
                "cwd": "${workspaceFolder}/qawno"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "pawn",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*?)\\(([0-9]*)[- 0-9]*\\) \\: (fatal error|error|warning) [0-9]*\\: (.*)$",
                    "file": 1,
                    "location": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        }
    ]
}